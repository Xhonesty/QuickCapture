<Window x:Class="QuickCapture.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="轻截 · QuickCapture" Width="560" Height="640" MinWidth="440" MinHeight="465" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Thickness x:Key="MainSectionPadding">8</Thickness>
    <Thickness x:Key="MainSectionGap">0,0,0,6</Thickness>
    <Style x:Key="MainSection" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
      <Setter Property="Padding" Value="{StaticResource MainSectionPadding}"/>
      <Setter Property="Margin" Value="{StaticResource MainSectionGap}"/>
    </Style>
    <Style x:Key="MainSectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSection}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MainAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="96"/><Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="RecentFileRow" TargetType="ListBoxItem">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <EventSetter Event="Loaded" Handler="RecentRow_Loaded"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource BadgeBackground}"/>
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
    <Grid x:Name="MainContent" Margin="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="{StaticResource MainSectionGap}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ThemeToggle" Content="切换浅色" Click="ThemeToggle_Click"/>
          <Button Content="设置" Click="Settings_Click" Margin="0"/>
        </StackPanel>
        <TextBlock Text="截图与录屏" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </DockPanel>
      <Border Grid.Row="1" Style="{StaticResource MainSection}">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <TextBlock x:Name="ShotKeyLabel" DockPanel.Dock="Right" Text="Ctrl+Alt+S" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
            <TextBlock Text="截图" Style="{StaticResource MainSectionTitle}"/>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="ShotMode" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="框选区域"/><ComboBoxItem Content="选择窗口"/><ComboBoxItem Content="整个桌面"/></ComboBox>
            <Button x:Name="ScreenshotButton" Grid.Column="1" Style="{StaticResource MainAction}" Content="开始截图" Click="Screenshot_Click" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentForeground}"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <CheckBox x:Name="AutoSaveBox" Content="复制时自动保存"/>
            <CheckBox x:Name="SnapWindowBox" Content="自动吸附窗口" ToolTip="悬停预选窗口；单击确认；拖动自由框选" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource MainSection}">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <TextBlock x:Name="RecordKeyLabel" DockPanel.Dock="Right" Text="Ctrl+Alt+R" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
            <TextBlock Text="录屏" Style="{StaticResource MainSectionTitle}"/>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="RecordMode" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="框选区域"/><ComboBoxItem Content="选择窗口"/><ComboBoxItem Content="鼠标所在屏幕"/></ComboBox>
            <Button x:Name="RecordButton" Grid.Column="1" Style="{StaticResource MainAction}" Content="开始录屏" Click="Recording_Click"/>
          </Grid>
          <DockPanel Margin="0,4,0,4">
            <Button x:Name="RepeatButton" DockPanel.Dock="Right" Style="{StaticResource MainAction}" Content="重复上次区域" Click="Repeat_Click"/>
            <CheckBox x:Name="SnapRecordWindowBox" Content="自动吸附窗口" ToolTip="悬停预选窗口；单击开始；拖动自由框选"/>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="SystemAudioBox" Content="系统声音"/>
            <CheckBox x:Name="MicrophoneBox" Grid.Column="1" Content="麦克风"/>
            <CheckBox x:Name="CursorBox" Grid.Column="2" Content="显示鼠标" Margin="0"/>
            <ComboBox x:Name="FpsBox" Grid.Column="4" MinWidth="86" Width="86" SelectedIndex="1" ToolTip="录制帧率">
              <ComboBoxItem Content="15 FPS"/><ComboBoxItem Content="30 FPS"/><ComboBoxItem Content="60 FPS"/>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>
      <Grid x:Name="RecentSectionSlot" Grid.Row="3">
        <Border x:Name="RecentCard" Style="{StaticResource MainSection}" VerticalAlignment="Top">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Style="{StaticResource MainAction}" Content="保存目录" Click="Folder_Click"/>
              <TextBlock Text="最近文件" Style="{StaticResource MainSectionTitle}"/>
            </DockPanel>
            <ListBox x:Name="RecentList" Grid.Row="1" Background="Transparent" BorderThickness="0" MouseDoubleClick="Recent_DoubleClick" KeyDown="Recent_KeyDown" Padding="0" ItemContainerStyle="{StaticResource RecentFileRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True">
              <ListBox.Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                  <!-- The card already supplies its border and padding. The
                       default ListBox template adds inner chrome that steals
                       height from the complete 44-DIP rows. -->
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="PART_ScrollViewer" Background="{TemplateBinding Background}" Padding="0" Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                          <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                </Style>
              </ListBox.Style>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding Name}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Viewbox Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding MediaType}">
                      <Path Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20">
                        <Path.Style>
                          <Style TargetType="Path">
                            <Setter Property="Data" Value="M 3,2 L 17,2 Q 18,2 18,3 L 18,17 Q 18,18 17,18 L 3,18 Q 2,18 2,17 L 2,3 Q 2,2 3,2 Z M 2,14 L 7,9 L 11,13 L 14,10 L 18,14 M 14,6 A 1,1 0 1 1 12,6 A 1,1 0 1 1 14,6"/>
                            <Style.Triggers><DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="Data" Value="M 3,2 L 17,2 Q 18,2 18,3 L 18,17 Q 18,18 17,18 L 3,18 Q 2,18 2,17 L 2,3 Q 2,2 3,2 Z M 8,6 L 14,10 L 8,14 Z"/></DataTrigger></Style.Triggers>
                          </Style>
                        </Path.Style>
                      </Path>
                    </Viewbox>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                      <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontHelp}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Text="暂无记录 · 截图或录屏后会显示在这里" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontHelp}" VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=RecentList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Border>
      </Grid>
      <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,6,0,0" Text="就绪 · 关闭后驻留托盘" Foreground="{DynamicResource TextSecondary}" FontSize="{StaticResource FontHelp}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Grid>
</Window>
