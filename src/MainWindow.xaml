<Window x:Class="QuickCapture.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuickCapture" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="轻截 · QuickCapture" Width="480" Height="680" MinWidth="480" MinHeight="576" WindowStyle="None" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="14"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PanelStyles.xaml"/></ResourceDictionary.MergedDictionaries>
      <Style x:Key="MainSection" TargetType="Border" BasedOn="{StaticResource PanelCard}"/>
      <Style x:Key="MainAction" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Width" Value="122"/></Style>
      <Style x:Key="WindowControl" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Background" Value="{DynamicResource WindowBackground}"/><Setter Property="Foreground" Value="{DynamicResource DisabledForeground}"/><Setter Property="Height" Value="24"/></Style>
      <Style x:Key="RecentFileRow" TargetType="ListBoxItem">
        <Setter Property="Height" Value="48"/><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="Background" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource PanelBackground}"/><Setter Property="BorderThickness" Value="0.5"/><Setter Property="Cursor" Value="Hand"/><EventSetter Event="Loaded" Handler="RecentRow_Loaded"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="RowSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource HoverBackground}"/><Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledForeground}"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Border CornerRadius="14" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.5">
    <Grid x:Name="MainContent" Margin="16,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,4" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="截图与录屏" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource WindowControl}" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化"><Path Data="M 1,7 L 11,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12"/></Button>
          <Button Style="{StaticResource WindowControl}" Click="Maximize_Click" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原"><Path Data="M 2,2 L 10,2 L 10,10 L 2,10 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12"/></Button>
          <Button Style="{StaticResource WindowControl}" Click="Close_Click" ToolTip="关闭后驻留托盘" AutomationProperties.Name="关闭"><Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12"/></Button>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
        <Button x:Name="ThemeToggle" Style="{StaticResource PillButton}" Click="ThemeToggle_Click" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource PanelIcon}" Data="M 8,1.5 A 6.5,6.5 0 1 0 8,14.5 A 6.5,6.5 0 1 0 8,1.5 M 8,1.5 L 8,14.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Margin="0,0,6,0"/><TextBlock x:Name="ThemeToggleLabel" Text="切换浅色"/></StackPanel></Button>
        <Button Style="{StaticResource PillButton}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource PanelIcon}" Data="M 8,5.5 A 2.5,2.5 0 1 0 8,10.5 A 2.5,2.5 0 1 0 8,5.5 M 8,1.5 L 8,3.5 M 8,12.5 L 8,14.5 M 1.5,8 L 3.5,8 M 12.5,8 L 14.5,8 M 3.4,3.4 L 4.8,4.8 M 11.2,11.2 L 12.6,12.6 M 12.6,3.4 L 11.2,4.8 M 4.8,11.2 L 3.4,12.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Margin="0,0,6,0"/><TextBlock Text="设置"/></StackPanel></Button>
      </StackPanel>
      <Border Grid.Row="2" Style="{StaticResource MainSection}"><StackPanel>
        <DockPanel Margin="0,0,0,10">
          <Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="10,0,0,0"><TextBlock x:Name="ShotKeyLabel" FontSize="11" Foreground="{DynamicResource BadgeForeground}"/></Border>
          <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}"><Path Style="{StaticResource PanelIcon}" Data="M 5,1.5 L 5,11 L 14.5,11 M 1.5,5 L 11,5 L 11,14.5"/></Border>
          <StackPanel><TextBlock Text="截图" Style="{StaticResource PanelTitle}"/><TextBlock Text="快速截取屏幕内容，支持区域选择" Style="{StaticResource PanelHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/></StackPanel>
        </DockPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="ShotMode" SelectedIndex="0" Margin="0,0,8,0" AutomationProperties.Name="截图模式"><ComboBoxItem Content="框选区域"/><ComboBoxItem Content="选择窗口"/><ComboBoxItem Content="整个桌面"/></ComboBox>
          <Button x:Name="ScreenshotButton" Grid.Column="1" Style="{StaticResource MainAction}" Content="开始截图" Click="Screenshot_Click"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="2,10,0,0"><CheckBox x:Name="AutoSaveBox" Content="复制时自动保存"/><CheckBox x:Name="SnapWindowBox" Content="自动吸附窗口" ToolTip="悬停预选窗口；单击确认；拖动自由框选" Margin="16,0,0,0"/></StackPanel>
      </StackPanel></Border>
      <Border Grid.Row="3" Style="{StaticResource MainSection}"><StackPanel>
        <DockPanel Margin="0,0,0,10">
          <Border DockPanel.Dock="Right" Style="{StaticResource KeyChip}" Margin="10,0,0,0"><TextBlock x:Name="RecordKeyLabel" FontSize="11" Foreground="{DynamicResource BadgeForeground}"/></Border>
          <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}"><Path Style="{StaticResource PanelIcon}" Data="M 3,4.5 L 8.5,4.5 Q 10,4.5 10,6 L 10,10 Q 10,11.5 8.5,11.5 L 3,11.5 Q 1.5,11.5 1.5,10 L 1.5,6 Q 1.5,4.5 3,4.5 M 10,8 L 14.5,5.2 L 14.5,10.8 Z"/></Border>
          <StackPanel><TextBlock Text="录屏" Style="{StaticResource PanelTitle}"/><TextBlock Text="高清录制屏幕内容，轻松制作演示视频" Style="{StaticResource PanelHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/></StackPanel>
        </DockPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="RecordMode" SelectedIndex="0" Margin="0,0,8,0" AutomationProperties.Name="录屏模式"><ComboBoxItem Content="框选区域"/><ComboBoxItem Content="选择窗口"/><ComboBoxItem Content="鼠标所在屏幕"/></ComboBox>
          <Button x:Name="RecordButton" Grid.Column="1" Style="{StaticResource MainAction}" Click="Recording_Click"><StackPanel Orientation="Horizontal"><Ellipse x:Name="RecordingDot" Width="8" Height="8" Fill="{DynamicResource Danger}" Margin="0,0,6,0" Visibility="Collapsed"/><TextBlock x:Name="RecordButtonLabel" Text="开始录屏"/></StackPanel></Button>
        </Grid>
        <Grid Margin="2,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="8"/><RowDefinition Height="28"/></Grid.RowDefinitions>
          <CheckBox x:Name="SnapRecordWindowBox" Content="自动吸附窗口" ToolTip="悬停预选窗口；单击开始；拖动自由框选"/>
          <Button x:Name="RepeatButton" Grid.Column="1" Height="28" Content="重复上次区域" IsEnabled="False" Click="Repeat_Click" ToolTip="使用上次的框选区域"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal"><CheckBox x:Name="SystemAudioBox" Content="系统声音"/><CheckBox x:Name="MicrophoneBox" Content="麦克风" Margin="12,0,0,0"/><CheckBox x:Name="CursorBox" Content="显示鼠标" Margin="12,0,0,0"/></StackPanel>
          <ComboBox x:Name="FpsBox" Grid.Row="2" Grid.Column="1" Height="28" FontSize="12" SelectedIndex="1" ToolTip="录制帧率" AutomationProperties.Name="录制帧率"><ComboBoxItem Content="15 FPS"/><ComboBoxItem Content="30 FPS"/><ComboBoxItem Content="60 FPS"/></ComboBox>
        </Grid>
      </StackPanel></Border>
      <Grid x:Name="RecentSectionSlot" Grid.Row="4"><Border x:Name="RecentCard" Style="{StaticResource MainSection}" VerticalAlignment="Top"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
          <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Click="Folder_Click" VerticalAlignment="Top" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource PanelIcon}" Data="M 3,3 L 6,3 L 7.5,5 L 13.5,5 Q 15,5 15,6.5 L 15,12.5 Q 15,14 13.5,14 L 3,14 Q 1.5,14 1.5,12.5 L 1.5,4.5 Q 1.5,3 3,3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Margin="0,0,6,0"/><TextBlock Text="保存目录"/></StackPanel></Button>
          <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}"><Path Style="{StaticResource PanelIcon}" Data="M 8,1.5 A 6.5,6.5 0 1 0 8,14.5 A 6.5,6.5 0 1 0 8,1.5 M 8,4.5 L 8,8 L 10.5,9.5"/></Border>
          <StackPanel><TextBlock Text="最近文件" Style="{StaticResource PanelTitle}"/><TextBlock Text="自动保存历史记录，方便快速查找" Style="{StaticResource PanelHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/></StackPanel>
        </DockPanel>
        <ListBox x:Name="RecentList" Grid.Row="1" Background="{DynamicResource PanelBackground}" BorderThickness="0" MouseDoubleClick="Recent_DoubleClick" KeyDown="Recent_KeyDown" Padding="0" ItemContainerStyle="{StaticResource RecentFileRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer x:Name="PART_ScrollViewer" Padding="0" Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ListBox.Style>
          <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <local:RecentThumbnail FilePath="{Binding Path}" Revision="{Binding Revision}" ToolsPath="{Binding ToolsPath}" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextHint}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <Button Style="{StaticResource IconButton}" Click="RecentMore_Click" ToolTip="更多操作" AutomationProperties.Name="更多操作"><Path Style="{StaticResource PanelIcon}" Data="M 3,8 L 3.1,8 M 8,8 L 8.1,8 M 13,8 L 13.1,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2"/></Button>
              <Border Width="0.5" Height="16" Background="{DynamicResource BorderBrush}" Margin="2,0"/>
              <Button Style="{StaticResource IconButton}" Click="RecentFolder_Click" ToolTip="打开所在目录" AutomationProperties.Name="打开所在目录"><Path Style="{StaticResource PanelIcon}" Data="M 3,3 L 6,3 L 7.5,5 L 13.5,5 Q 15,5 15,6.5 L 15,12.5 Q 15,14 13.5,14 L 3,14 Q 1.5,14 1.5,12.5 L 1.5,4.5 Q 1.5,3 3,3 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14"/></Button>
            </StackPanel>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="暂无记录 · 截图或录屏后会显示在这里" Foreground="{DynamicResource TextHint}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=RecentList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid></Border></Grid>
      <DockPanel Grid.Row="5" Margin="4,6,4,0"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource ReadyBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/><Path Style="{StaticResource PanelIcon}" Data="M 8,1.5 A 6.5,6.5 0 1 0 8,14.5 A 6.5,6.5 0 1 0 8,1.5 M 8,7.5 L 8,11 M 8,4.8 L 8,5.2" Stroke="{DynamicResource TextHint}" Width="12" Height="12" Margin="0,0,6,0"/><TextBlock x:Name="StatusText" Text="就绪 · 关闭后驻留托盘" Foreground="{DynamicResource TextHint}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></DockPanel>
    </Grid>
  </Border>
</Window>
